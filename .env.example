# ---------------------------------------------------------------------------
# Real Estate Network — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Branding -------------------------------------------------------------
# The product name is configurable; it is not hard-coded in the codebase.
NEXT_PUBLIC_APP_NAME="GetMeSpace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://getmespace.in
NEXT_PUBLIC_APP_TAGLINE="The verified real-estate inventory network"
NEXT_PUBLIC_SUPPORT_EMAIL="support@getmespace.in"
NEXT_PUBLIC_LEGAL_ENTITY="BUILTFORBUSINESS LLP"   # operating company, shown in the footer

# ---------------------------------------------------------------------------
# Particulars the legal pages must state, and must not invent.
#
# Leave one blank and the page shows the gap rather than a plausible-looking
# placeholder — a made-up registered address is a false statement in a document
# people are asked to rely on. /api/v1/health lists whatever is still missing.
#
# The grievance officer's name and contact are required to be published by the
# IT (Intermediary Guidelines) Rules, 2021.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=""   # LLPIN / CIN from the MCA
NEXT_PUBLIC_LEGAL_GSTIN=""
NEXT_PUBLIC_LEGAL_ADDRESS=""               # full registered office address
NEXT_PUBLIC_GRIEVANCE_OFFICER=""           # named individual
NEXT_PUBLIC_GRIEVANCE_EMAIL=""             # defaults to the support address
NEXT_PUBLIC_PRIVACY_EMAIL=""               # where DPDP requests are received
NEXT_PUBLIC_LEGAL_JURISDICTION=""          # e.g. "Noida, Uttar Pradesh"
NEXT_PUBLIC_GOVERNING_LAW="India"

# --- Supabase -------------------------------------------------------------
# These two are PUBLIC BY DESIGN and must keep the NEXT_PUBLIC_ prefix: the
# browser client connects with them. The anon key carries the `anon` role and
# every query it makes goes through Row Level Security — RLS is the boundary,
# not the secrecy of this key. On Vercel, store both as "Config", not "Secret".
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# It bypasses RLS entirely. On Vercel, store this as a "Secret".
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Maps -----------------------------------------------------------------
# Browser key: restrict by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key: restrict by IP. Used for geocoding / Places lookups server-side.
GOOGLE_MAPS_API_KEY=""
MAP_PROVIDER="google"          # google | none

# --- Embeds ---------------------------------------------------------------
# Extra hosts allowed inside an iframe, comma-separated. YouTube, Vimeo,
# Matterport, Kuula and Google Maps are allowed by default. A tour on a host
# not listed here opens in a new tab rather than being blocked by the CSP.
EMBED_ALLOWED_HOSTS=""

# --- AI -------------------------------------------------------------------
AI_PROVIDER="rules"            # rules | anthropic | openai
AI_PROVIDER_API_KEY=""
AI_MODEL=""

# --- Notification providers ----------------------------------------------
EMAIL_PROVIDER="console"       # console | resend | ses | sendgrid
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="no-reply@getmespace.in"

SMS_PROVIDER="noop"            # noop | msg91 | twilio  (TRAI DLT required in IN)
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID=""

WHATSAPP_PROVIDER="noop"       # noop | meta_cloud | gupshup
WHATSAPP_PROVIDER_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

PUSH_PROVIDER="noop"           # noop | webpush | fcm
PUSH_PROVIDER_API_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Feature flags --------------------------------------------------------
# Investor module stays OFF until the legal review in docs/LEGAL_REVIEW.md
# (item L1) is signed off. Do not enable it for a production deployment.
ENABLE_INVESTOR_MODULE="false"
ENABLE_AI_SEARCH="true"
ENABLE_AI_LISTING_ASSISTANT="true"
ENABLE_VIRTUAL_TOURS="true"
ENABLE_WHATSAPP="false"
ENABLE_SMS="false"
ENABLE_PUSH="false"
ENABLE_DOCUMENT_AI="false"
ENABLE_PROPERTY_VALUATION="false"
ENABLE_NRI_MODE="false"
ENABLE_MARKETING_KIT="true"

# --- Platform defaults ----------------------------------------------------
DEFAULT_CURRENCY="INR"
DEFAULT_COUNTRY="IN"
DEFAULT_LOCALE="en-IN"
DEFAULT_TIMEZONE="Asia/Kolkata"

# --- Security -------------------------------------------------------------
# Requests per window for public API routes.
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="60"
# Max contact reveals an agent may perform per day.
CONTACT_REVEAL_DAILY_LIMIT="25"
# Geofence radius (metres) used to qualify a physical site visit.
VISIT_MIN_LEAD_TIME_HOURS="12"        # minimum notice before a site visit
VISIT_GEOFENCE_RADIUS_METERS="200"
# Minimum on-site minutes for a visit to be considered meaningful.
VISIT_MIN_DURATION_MINUTES="10"

# --- Observability --------------------------------------------------------
LOG_LEVEL="info"               # debug | info | warn | error
SENTRY_DSN=""
